# Telegram (BotFather → https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=
# Numeri id Telegram autorizzati, separati da virgola (vuoto = pairing via PAIRING_CODE)
ALLOWED_USER_IDS=
# Codice di pairing per il primo /start (default-deny se assenti entrambi)
PAIRING_CODE=
# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=deepseek-v4-flash:0731-cloud
# Modello per la trascrizione vocale (audio): whisper è stato rimosso da Ollama.
# gemma4:cloud (default) NON ha audio → per la voce serve un modello locale audio-capable
# come gemma4:e2b o gemma4:e4b (ollama pull gemma4:e2b).
TRANSCRIBE_MODEL=gemma4:cloud
# Limiti
MAX_HEADLESS_SESSIONS=2
PERMISSION_TIMEOUT_SECONDS=120
WORKSPACE_DIRS=
# API locale (loopback) per l'auto-attach delle sessioni via hook SessionStart
API_PORT=4123
# Stato e attivazione
STATE_DIR=~/.ollama-rc
ARMED_ON_START=false
