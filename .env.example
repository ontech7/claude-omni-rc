# Telegram bot (get a token from @BotFather)
TELEGRAM_BOT_TOKEN=
# Authorized Telegram user ids, comma-separated (leave empty to use PAIRING_CODE)
ALLOWED_USER_IDS=
# Pairing code for the first /start (default-deny when both are empty)
PAIRING_CODE=
# Ollama (used for headless sessions by default and for Ollama-specific
# features: vision check, tool-call summaries, context length)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Provider for headless sessions (env of the Claude Code CLI). Leave unset to
# use Ollama (OLLAMA_BASE_URL). For any other provider — a proxy, or Anthropic
# itself — set these:
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_API_KEY=
# Model for headless sessions (default; override per-session with /new --model)
DEFAULT_MODEL=deepseek-v4-flash:0731-cloud
# Limits
MAX_HEADLESS_SESSIONS=2
PERMISSION_TIMEOUT_SECONDS=120
WORKSPACE_DIRS=
# Local loopback API port (SessionStart hook auto-attach, permission tool)
API_PORT=4123
# Where Claude Code stores session transcripts (~/.claude/projects)
PROJECTS_DIR=~/.claude/projects
# State
STATE_DIR=~/.claude-omni-rc
ARMED_ON_START=false
