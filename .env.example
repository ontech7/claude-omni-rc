# Telegram bot (get a token from @BotFather)
TELEGRAM_BOT_TOKEN=
# Authorized Telegram user ids, comma-separated (leave empty to use PAIRING_CODE)
ALLOWED_USER_IDS=
# Pairing code for the first /start (default-deny when both are empty)
PAIRING_CODE=
# Ollama (used for headless sessions by default and for Ollama-specific
# features: vision check, tool-call summaries, context length)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Provider for sessions (env of the Claude Code CLI; used by headless `/new`
# and by the `omni-rc` terminal launcher). Leave unset to use Ollama
# (OLLAMA_BASE_URL). For any other provider — a proxy, or Anthropic itself —
# set these:
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_API_KEY=
# Model for sessions (headless and `omni-rc` default; override per-session
# with /new --model or omni-rc -m). A model starting with `claude-` runs on
# Anthropic; any other model runs on Ollama.
DEFAULT_MODEL=deepseek-v4-flash:0731-cloud
# Permission mode for headless /new sessions when no flag is given:
#   standard = every tool call needs an explicit approval from Telegram (default)
#   auto     = approve everything, unattended. An agent with shell access to
#              WORKSPACE_DIRS — opt in only if you know you want that.
DEFAULT_PERMISSION_MODE=standard
# Limits
MAX_HEADLESS_SESSIONS=2
PERMISSION_TIMEOUT_SECONDS=120
# Project roots, ':'-separated. REQUIRED for /new: headless sessions run in the
# first one, and /new refuses to start until this is set (it never falls back to
# your home directory).
WORKSPACE_DIRS=
# Local loopback API port (SessionStart hook auto-attach, permission tool)
API_PORT=4123
# Where Claude Code stores session transcripts (~/.claude/projects)
PROJECTS_DIR=~/.claude/projects
# State
STATE_DIR=~/.claude-omni-rc
ARMED_ON_START=false
# How often to re-check the cwd of a tracked session's claude process (costs a
# `ps` + `lsof`); only needed to follow a session that moves into a git worktree.
CWD_REFRESH_MS=10000
