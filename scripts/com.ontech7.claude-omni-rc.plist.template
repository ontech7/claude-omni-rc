<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ontech7.claude-omni-rc</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__TSX__</string>
    <string>__DAEMON__</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__STATE__/logs/daemon.log</string>
  <key>StandardErrorPath</key><string>__STATE__/logs/daemon.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- __USER_BIN__ = $HOME/.local/bin (uv/pipx): ollama-usage e claude ci
         vivono e il PATH di launchd non li include. Il daemon li aggiunge
         comunque a runtime (src/path.ts) — qui è per l'env esplicito. -->
    <key>PATH</key><string>__USER_BIN__:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
